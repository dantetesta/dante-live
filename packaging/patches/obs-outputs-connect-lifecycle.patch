+/* Connection threads remain joinable. Holding connect_mutex across join is
+ * safe: connect_thread never acquires it. This serializes stop, restart and
+ * destruction and prevents joining a detached/recycled pthread_t. */
+static bool join_connect_thread(struct rtmp_stream *stream)
+{
+	if (!stream->connect_mutex_initialized)
+		return true;
+	pthread_mutex_lock(&stream->connect_mutex);
+	bool ok = true;
+	if (stream->connect_thread_valid) {
+		if (pthread_equal(stream->connect_thread, pthread_self())) {
+			warn("Refusing to join the current RTMP connection thread");
+			ok = false;
+		} else {
+			int result = pthread_join(stream->connect_thread, NULL);
+			if (result == 0)
+				stream->connect_thread_valid = false;
+			else {
+				warn("Failed to join RTMP connection thread: %d", result);
+				ok = false;
+			}
+		}
+	}
+	pthread_mutex_unlock(&stream->connect_mutex);
+	return ok;
+}
